{
  "name": "pi-git-safe-write",
  "version": "1.0.0",
  "description": "pi extension that gates write/edit to existing untracked files in git repos",
  "keywords": [
    "pi-package",
    "pi-extension",
    "git",
    "safety"
  ],
  "license": "MIT",
  "author": "David Raistrick",
  "homepage": "https://github.com/keen99/pi-git-safe-write",
  "repository": {
    "type": "git",
    "url": "https://github.com/keen99/pi-git-safe-write.git"
  },
  "type": "module",
  "main": "./index.ts",
  "scripts": {
    "test": "node --import tsx --test test/unit.test.ts",
    "test:matrix": "node test/release-matrix.mjs"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.3",
    "tsx": "^4.23.15"
  }
}
